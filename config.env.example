# NATS server connection string
NATSCONNSTR=nats://localhost:4222
NATSSTREAM=wallet

# PostgreSQL connection string/address
STORAGECONNSTR=localhost:5432

# HTTP server port
SERVERPORT=localhost:8080

# Exchange service address
EXCHANGEADDR=localhost:8081

# JWT signing secret. Replace this value outside local development.
AUTHSECRET=development-secret
